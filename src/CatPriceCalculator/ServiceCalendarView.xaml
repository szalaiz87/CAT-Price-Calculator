<UserControl x:Class="CatPriceCalculator.ServiceCalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" Padding="8,5"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" Foreground="{TemplateBinding Foreground}"/></Grid></ToggleButton>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{DynamicResource InputSurface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="12"/><RowDefinition Height="96"/><RowDefinition Height="12"/><RowDefinition Height="168"/><RowDefinition Height="12"/><RowDefinition Height="232"/><RowDefinition Height="12"/><RowDefinition Height="184"/><RowDefinition Height="12"/><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource MachineHeroFrame}"><Border Style="{StaticResource MachineHeroOverlay}"><StackPanel VerticalAlignment="Center"><TextBlock Text="SZERVIZNAPTÁR" Style="{StaticResource PageHeading}" Foreground="{DynamicResource HeroForeground}"/><TextBlock Text="Ügyfél · gép · munkatárs · feladat" Foreground="{DynamicResource HeroDetailForeground}" Margin="0,6,0,0"/></StackPanel></Border></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ügyfél- és géptörzs" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="LastImportStatus" Text="Még nem történt import." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="26"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="Ügyfél" Style="{StaticResource FieldLabel}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="CustomerDisplay" IsReadOnly="True" FontSize="14"/><Button x:Name="SearchButton" Grid.Column="2" Content="Ügyfél keresése" Click="SearchCustomers" Padding="6,2"/></Grid><TextBlock Grid.Row="3" Text="Az ügyfélhez rendelt gép" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MachineInput" Grid.Row="4" TextSearch.TextPath="Name" IsTextSearchEnabled="True"/></Grid></Border>
  <Border Grid.Row="6" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="8"/><RowDefinition Height="24"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="Munkatárs naptára" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StaffInput" Grid.Row="1" SelectionChanged="StaffChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock x:Name="Name" Text="{Binding DisplayName}"/><DataTemplate.Triggers><DataTrigger Binding="{Binding Id}" Value="szalai"><Setter TargetName="Name" Property="Foreground" Value="{DynamicResource ManagerText}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="2" Text="Dátum (éééé.hh.nn)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DateInput" Grid.Column="2" Grid.Row="1" MaxLength="10"/><TextBlock Grid.Row="3" Text="Kapcsolattartó neve" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContactInput" Grid.Row="4" MaxLength="200"/><TextBlock Grid.Column="2" Grid.Row="3" Text="Telefonszám" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhoneInput" Grid.Column="2" Grid.Row="4" MaxLength="100"/><TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="A munkát rögzítette" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecorderInput" Grid.Row="7" Grid.ColumnSpan="3" IsReadOnly="True" IsTabStop="False"/></Grid></Border>
  <Border Grid.Row="8" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="10"/><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Gép lokációja" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LocationInput" Grid.Row="1" MaxLength="300"/><TextBlock Grid.Row="3" Text="Hibaleírás / elvégzendő munka" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DescriptionInput" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" FontSize="14"/></Grid></Border>
  <Grid Grid.Row="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Feladat mentése" Click="SaveJob"/><Button Grid.Column="2" Content="Havi naptár megnyitása" Click="OpenCalendar"/></Grid>
  <TextBlock x:Name="Status" Grid.Row="11" Text="Egy napra több feladat is rögzíthető." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
