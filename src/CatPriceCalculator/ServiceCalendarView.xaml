<UserControl x:Class="CatPriceCalculator.ServiceCalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource InputSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}" Padding="8,5"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" Foreground="{TemplateBinding Foreground}"/></Grid></ToggleButton>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{DynamicResource InputSurface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="12"/><RowDefinition Height="132"/><RowDefinition Height="12"/><RowDefinition Height="154"/><RowDefinition Height="12"/><RowDefinition Height="172"/><RowDefinition Height="12"/><RowDefinition Height="214"/><RowDefinition Height="12"/><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource MachineHeroFrame}"><Border Style="{StaticResource MachineHeroOverlay}"><StackPanel VerticalAlignment="Center"><TextBlock Text="SZERVIZNAPTÁR" Style="{StaticResource PageHeading}" Foreground="{DynamicResource HeroForeground}"/><TextBlock Text="Ügyfél · gép · munkatárs · feladat" Foreground="{DynamicResource HeroDetailForeground}" Margin="0,6,0,0"/></StackPanel></Border></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Excel-adatbázisok importálása" Style="{StaticResource SectionHeading}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Ügyfél-Excel kiválasztása" Click="ChooseCustomers" Padding="4,2" Margin="0,0,4,0"/><Button Grid.Column="1" Content="Gép-Excel kiválasztása" Click="ChooseMachines" Padding="4,2" Margin="4,0,0,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Importmappa megnyitása" Click="OpenImportFolder" Padding="4,2" Margin="0,0,4,0"/><Button x:Name="ImportButton" Grid.Column="1" Content="Adatbázisok beolvasása" Click="ImportCatalog" Padding="4,2" Margin="4,0,0,0"/></Grid><TextBlock x:Name="ImportStatus" Grid.Row="3" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></Grid></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="26"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="Ügyfél" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CustomerInput" Grid.Row="1" SelectionChanged="CustomerChanged" TextSearch.TextPath="Name" IsTextSearchEnabled="True"/><TextBlock Grid.Row="3" Text="Az ügyfélhez rendelt gép" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MachineInput" Grid.Row="4" TextSearch.TextPath="Name" IsTextSearchEnabled="True"/></Grid></Border>
  <Border Grid.Row="6" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="24"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="Munkatárs naptára" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="StaffInput" Grid.Row="1" DisplayMemberPath="Name"/><TextBlock Grid.Column="2" Text="Dátum (éééé.hh.nn)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DateInput" Grid.Column="2" Grid.Row="1" MaxLength="10"/><TextBlock Grid.Row="3" Text="Kapcsolattartó neve" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ContactInput" Grid.Row="4" MaxLength="200"/><TextBlock Grid.Column="2" Grid.Row="3" Text="Telefonszám" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhoneInput" Grid.Column="2" Grid.Row="4" MaxLength="100"/></Grid></Border>
  <Border Grid.Row="8" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="10"/><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Gép lokációja" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LocationInput" Grid.Row="1" MaxLength="300"/><TextBlock Grid.Row="3" Text="Hibaleírás / elvégzendő munka" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DescriptionInput" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" FontSize="14"/></Grid></Border>
  <Grid Grid.Row="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Feladat mentése" Click="SaveJob"/><Button Grid.Column="2" Content="Havi naptár megnyitása" Click="OpenCalendar"/></Grid>
  <TextBlock x:Name="Status" Grid.Row="11" Text="Egy napra több feladat is rögzíthető." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
