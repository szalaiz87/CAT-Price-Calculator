<UserControl x:Class="CatPriceCalculator.UpsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CatPriceCalculator">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="392" /><RowDefinition Height="12" /><RowDefinition Height="180" /><RowDefinition Height="12" /><RowDefinition Height="190" /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="24" /><RowDefinition Height="8" /><RowDefinition Height="66" /><RowDefinition Height="12" /><RowDefinition Height="66" /><RowDefinition Height="12" /><RowDefinition Height="62" /><RowDefinition Height="12" /><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Image Source="{StaticResource UpsLogo}" Width="28" Height="28" Margin="0,0,12,0" /><TextBlock Text="UPS kapcsolat" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Grid.Row="1" Text="Tracking API • saját UPS alkalmazás • éles hozzáférés" Style="{StaticResource Caption}" />
                <local:SecretEntry x:Name="ClientIdInput" Grid.Row="3" Caption="Client ID" ValueChanged="CredentialChanged" />
                <local:SecretEntry x:Name="ClientSecretInput" Grid.Row="5" Caption="Client Secret" ValueChanged="CredentialChanged" />
                <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="154" /></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="UPS ügyfélszám (opcionális)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AccountInput" Grid.Row="2" MaxLength="6" FontSize="13" TextChanged="OptionChanged" ToolTip="Az alkalmazáshoz társított hat karakteres UPS ügyfélszám; x-merchant-id hitelesítési fejléc. A portálon is hozzá kell rendelni." /></Grid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Helyi 24 órás keret" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DailyLimitInput" Grid.Row="2" MaxLength="6" FontSize="13" TextChanged="OptionChanged" ToolTip="Helyi védelmi korlát, alapból 250 HTTP-kérés; a hitelesítés is számít. Nem a UPS hivatalos kvótája. Csak az engedélyezett hozzáférésed alapján növeld." /></Grid>
                </Grid>
                <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="UPS beállítások mentése" Click="SaveSettings" /><Button x:Name="DeleteButton" Grid.Column="2" Content="Mentett hozzáférés törlése" Click="DeleteCredentials" /></Grid>
                <TextBlock x:Name="ConnectionStatus" Grid.Row="10" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="24" /><RowDefinition Height="8" /><RowDefinition Height="38" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Kapcsolat kipróbálása" Style="{StaticResource SectionHeading}" />
                <TextBlock Grid.Row="1" Text="Egy saját UPS csomagszámmal, a mentett beállításokkal. Kizárólag kézzel." Style="{StaticResource Caption}" />
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions><TextBox x:Name="TestNumberInput" MaxLength="34" FontSize="13" TextChanged="TestEntryChanged" AutomationProperties.Name="Saját UPS tesztcsomag száma" /><Button x:Name="TestButton" Grid.Column="2" Content="Tesztlekérés" Click="TestConnection" IsEnabled="False" /></Grid>
                <TextBlock x:Name="TestStatus" Grid.Row="5" Text="Mentsd a hozzáférést, majd adj meg egy saját csomagszámot." Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource InsetCard}">
            <StackPanel>
                <TextBlock Text="Honnan szerezhető be?" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
                <TextBlock Text="1. UPS Developer Portal → belépés → My Apps → Create App." Margin="0,0,0,6" FontSize="12" />
                <TextBlock Text="2. Céges UPS ügyfélszám társítása; Tracking API kiválasztása." Margin="0,0,0,6" FontSize="12" />
                <TextBlock Text="3. Az alkalmazás adatlapjáról: Client ID és Client Secret." Margin="0,0,0,8" FontSize="12" />
                <TextBlock Text="Tokent és régi Access Key-t nem kell megadnod. A keret helyi védelem; a UPS saját korlátait a portálon ellenőrizd." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="UPS hozzáférés és hivatalos dokumentáció" Click="OpenDocumentation" Height="32" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="6" Text="Windows-felhasználóhoz kötött, titkosított mentés. Csak kézi lekérés." Style="{StaticResource Caption}" Margin="4,0" VerticalAlignment="Top" />
    </Grid>
</UserControl>
