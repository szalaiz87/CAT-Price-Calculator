<UserControl x:Class="CatPriceCalculator.ApiLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="LogRow">
            <Border Height="72" CornerRadius="8" Background="{DynamicResource InputSurface}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="8,6">
                <Border.ToolTip><ToolTip Background="{DynamicResource InputSurface}" Foreground="{DynamicResource TextPrimary}" Padding="10"><TextBlock Text="{Binding Details}" MaxWidth="420" TextWrapping="Wrap" /></ToolTip></Border.ToolTip>
                <Grid><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="4" /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Metadata}" FontSize="10" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="12" /><RowDefinition Height="38" /><RowDefinition Height="12" /><RowDefinition Height="520" /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
        <Border Style="{StaticResource InsetCard}"><StackPanel><TextBlock Text="FUTÁR API-NAPLÓ" Style="{StaticResource PageHeading}" /><TextBlock Text="A lekérés lépései, HTTP-válaszok és hibák. A kulcsokat, tokeneket és a válasz tartalmát nem naplózzuk." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" /></StackPanel></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="144" /></Grid.ColumnDefinitions><TextBlock x:Name="LogStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,12,0" /><Button Grid.Column="1" Content="Napló frissítése" Click="RefreshLog" ToolTip="Csak a helyi naplót olvassa újra, nem indít API-lekérést." /></Grid>
        <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="432" /><RowDefinition Height="30" /></Grid.RowDefinitions>
            <TextBlock Text="Legfrissebb bejegyzések elöl" Style="{StaticResource SectionHeading}" />
            <ItemsControl x:Name="LogRows" Grid.Row="1" ItemTemplate="{StaticResource LogRow}" />
            <TextBlock x:Name="EmptyLog" Grid.Row="1" Text="Még nincs API-lekérés. Indíts kézi tesztet vagy csomagfrissítést." Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" />
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /><ColumnDefinition Width="8" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions><TextBlock x:Name="LogPager" Style="{StaticResource Caption}" /><Button x:Name="LogPrev" Grid.Column="1" Click="PreviousPage" Padding="8" AutomationProperties.Name="Napló előző oldala"><Path Data="{StaticResource ChevronLeftIcon}" Style="{StaticResource ButtonIcon}" Width="6" Height="12" Margin="0" /></Button><Button x:Name="LogNext" Grid.Column="3" Click="NextPage" Padding="8" AutomationProperties.Name="Napló következő oldala"><Path Data="{StaticResource ChevronRightIcon}" Style="{StaticResource ButtonIcon}" Width="6" Height="12" Margin="0" /></Button></Grid>
        </Grid></Border>
        <Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
            <UniformGrid Columns="2"><Button Content="Naplómappa megnyitása" Click="OpenFolder" Margin="0,0,6,0" /><Button Content="API-napló törlése" Click="ClearLog" Margin="6,0,0,0" /></UniformGrid>
            <TextBlock Grid.Row="2" x:Name="LogLocation" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,0" />
        </Grid>
    </Grid>
</UserControl>
