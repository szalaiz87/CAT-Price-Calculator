<UserControl x:Class="CatPriceCalculator.UserSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CatPriceCalculator">
 <Grid><Grid.RowDefinitions><RowDefinition Height="246"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="154"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <TextBlock Text="Felhasználók" Style="{StaticResource SectionHeading}"/>
   <UniformGrid x:Name="UserRows" Grid.Row="1" Rows="3"/>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PreviousButton" Content="‹ Előző" Click="Previous" Padding="4,2"/><TextBlock x:Name="PageLabel" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button x:Name="NextButton" Grid.Column="4" Content="Következő ›" Click="Next" Padding="4,2"/></Grid>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="66"/><RowDefinition Height="12"/><RowDefinition Height="66"/><RowDefinition Height="12"/><RowDefinition Height="196"/><RowDefinition Height="12"/><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions>
   <TextBlock x:Name="EditorTitle" Text="Új felhasználó" Style="{StaticResource SectionHeading}"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Név" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameInput" Grid.Row="2" MaxLength="120" FontSize="14"/></Grid>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Felhasználónév" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameInput" Grid.Row="2" MaxLength="80" FontSize="14"/></Grid>
   </Grid>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><local:SecretEntry x:Name="PasswordInput" Caption="Jelszó"/><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Szerepkör" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RoleInput" Style="{StaticResource RoundedCombo}" Grid.Row="2" SelectionChanged="RoleChanged" FontSize="13"><ComboBoxItem Content="Felhasználó"/><ComboBoxItem Content="Adminisztrátor"/></ComboBox></Grid></Grid>
   <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Menük hozzáférése" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/><StackPanel x:Name="MenuPermissions"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Beállításfülek hozzáférése" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/><StackPanel x:Name="SettingsPermissions"/></StackPanel></Grid>
   <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Felhasználó mentése" Click="Save"/><Button Grid.Column="2" Content="Új felhasználó" Click="NewUser"/></Grid>
   <TextBlock x:Name="Status" Grid.Row="8" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
  </Grid></Border>
 </Grid>
</UserControl>
