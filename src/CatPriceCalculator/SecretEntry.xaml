<UserControl x:Class="CatPriceCalculator.SecretEntry" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="66">
    <Grid><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition Height="42" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="PresenceText" Grid.Column="1" Text="Nincs beírt érték" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentText}" /></Grid>
        <Grid Grid.Row="2">
            <PasswordBox x:Name="HiddenInput" MaxLength="512" Padding="12,4,56,4" PasswordChanged="HiddenChanged" />
            <TextBox x:Name="VisibleInput" Visibility="Collapsed" MaxLength="512" Padding="12,4,56,4" TextChanged="VisibleChanged" ScrollViewer.HorizontalScrollBarVisibility="Hidden" CaretBrush="{DynamicResource TextPrimary}" />
            <Button x:Name="RevealButton" Click="ToggleVisibility" Width="30" Height="30" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Érték megjelenítése" AutomationProperties.Name="Érték megjelenítése"><Path x:Name="RevealIcon" Data="{StaticResource EyeIcon}" Style="{StaticResource ButtonIcon}" Width="16" Height="16" Margin="0" /></Button>
        </Grid>
    </Grid>
</UserControl>
