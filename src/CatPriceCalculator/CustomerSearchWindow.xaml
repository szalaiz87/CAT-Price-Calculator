<Window x:Class="CatPriceCalculator.CustomerSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Linser Hungary · Ügyfélkereső" Width="820" Height="800" MinWidth="620" MinHeight="580" Background="{DynamicResource WindowSurface}" WindowStartupLocation="CenterScreen" Topmost="False">
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Grid Width="760" Height="740" Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="12"/><RowDefinition Height="108"/><RowDefinition Height="12"/><RowDefinition Height="430"/><RowDefinition Height="12"/><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><TextBlock Text="ÜGYFÉLKERESŐ" Style="{StaticResource PageHeading}"/></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions><TextBox x:Name="Query" TextChanged="QueryChanged" AutomationProperties.Name="Ügyfélnév keresése"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PrefixButton" Content="Megnevezés kezdete" Click="PrefixSearch" Padding="6,2"/><Button x:Name="AnywhereButton" Grid.Column="2" Content="Bárhol a megnevezésben" Click="AnywhereSearch" Padding="6,2"/></Grid></Grid></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10"><ListBox x:Name="Results" SelectionChanged="ResultChanged" MouseDoubleClick="ChooseDoubleClick" Background="Transparent" BorderThickness="0">
   <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
   <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/><TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Height" Value="33"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" Background="{DynamicResource InputSurface}" Padding="10,6" Margin="0,1" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SummaryGradient}"/><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
  </ListBox></Border>
  <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><Button x:Name="PreviousButton" Content="‹ Előző" Click="PreviousPage" Margin="0,0,6,0"/><Button x:Name="NextButton" Grid.Column="1" Content="Következő ›" Click="NextPage"/><TextBlock x:Name="Count" Grid.Column="2" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button x:Name="ChooseButton" Grid.Column="3" IsEnabled="False" Content="Ügyfél kiválasztása" Click="Choose"/></Grid>
  <TextBlock Grid.Row="7" Text="Az ékezetek és a kis-/nagybetűk nem számítanak. Dupla kattintással is választhat." Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
 </Grid></Viewbox>
</Window>
