<Window x:Class="CatPriceCalculator.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CatPriceCalculator" Title="Linser Hungary – bejelentkezés" Icon="Assets/LS-Germany.ico" Width="780" Height="580" MinWidth="480" MinHeight="400" Background="{DynamicResource WindowSurface}" FontFamily="{StaticResource AppFont}" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid>
  <Image Source="{StaticResource MachineBackground}" Stretch="UniformToFill"/>
  <Border Style="{StaticResource MachineHeroOverlay}" Padding="0"/>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
   <Border Style="{StaticResource Card}" Width="390" Padding="26">
    <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="12"/><RowDefinition Height="66"/><RowDefinition Height="16"/><RowDefinition Height="66"/><RowDefinition Height="20"/><RowDefinition Height="42"/><RowDefinition Height="64"/></Grid.RowDefinitions>
     <TextBlock Text="Bejelentkezés" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock Text="Felhasználónév" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameInput" Grid.Row="2" MaxLength="80" AutomationProperties.Name="Felhasználónév"/></Grid>
     <local:SecretEntry x:Name="PasswordInput" Grid.Row="4" Caption="Jelszó"/>
     <Button x:Name="LoginButton" Grid.Row="6" Content="Belépés" Click="SignIn" IsDefault="True"/>
     <TextBlock x:Name="Status" Grid.Row="7" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" Margin="0,12,0,0"/>
    </Grid>
   </Border>
  </Viewbox>
 </Grid>
</Window>
