<UserControl x:Class="CatPriceCalculator.ServiceImportSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="12"/><RowDefinition Height="170"/><RowDefinition Height="12"/><RowDefinition Height="170"/><RowDefinition Height="12"/><RowDefinition Height="52"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Szerviznaptár · import" Style="{StaticResource SectionHeading}"/><TextBlock Text="Válassza ki a partner- és gép-Excel-fájlt, majd olvassa be őket együtt. A korábbi naptárfeladatok megmaradnak." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Ügyféladatbázis (.xls / .xlsx)" Style="{StaticResource FieldLabel}"/><Button x:Name="CustomerButton" Grid.Row="1" Content="Ügyfél-Excel tallózása" Click="ChooseCustomers"/><TextBox x:Name="CustomerPath" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/></Grid></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Gépadatbázis (.xls / .xlsx)" Style="{StaticResource FieldLabel}"/><Button x:Name="MachineButton" Grid.Row="1" Content="Gép-Excel tallózása" Click="ChooseMachines"/><TextBox x:Name="MachinePath" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/></Grid></Border>
  <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ImportButton" Content="Adatbázisok beolvasása" Click="Import"/><Button x:Name="FolderButton" Grid.Column="2" Content="Importmappa és minták" Click="OpenFolder"/></Grid>
  <Border Grid.Row="8" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="Status" Text="Még nincs fájl kiválasztva." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/><TextBlock Text="A beolvasás csak akkor frissít, ha mindkét fájl érvényes. A tallózott útvonalak a következő indításkor is megmaradnak." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
