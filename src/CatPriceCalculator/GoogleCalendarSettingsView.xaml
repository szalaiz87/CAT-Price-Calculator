<UserControl x:Class="CatPriceCalculator.GoogleCalendarSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="12"/><RowDefinition Height="126"/><RowDefinition Height="12"/><RowDefinition Height="150"/><RowDefinition Height="12"/><RowDefinition Height="106"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Google Táblázatok · szerviznaptár" Style="{StaticResource SectionHeading}"/><TextBlock Text="Az app a forrás. A szerelők a táblázatot nézik; változtatások csak az appból kerülnek át. Az app saját LINSER munkalapokat hoz létre." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="36"/><RowDefinition Height="6"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Text="Google-táblázat teljes hivatkozása vagy azonosítója" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SheetInput" TextChanged="DraftChanged" Grid.Row="1" FontSize="13" MaxLength="500"/><Button Grid.Row="3" Content="Táblázat megnyitása" Click="OpenSheet"/></Grid></Border>
  <Border Grid.Row="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="32"/><RowDefinition Height="6"/><RowDefinition Height="32"/><RowDefinition Height="6"/><RowDefinition Height="24"/></Grid.RowDefinitions><TextBlock Text="Google szolgáltatásfiók JSON-kulcsa" Style="{StaticResource FieldLabel}"/><Button x:Name="ImportKeyButton" Grid.Row="1" Content="Kulcsfájl betallózása" Click="ImportKey"/><TextBox x:Name="EmailText" Grid.Row="3" FontSize="12" IsReadOnly="True" ToolTip="Ezzel a címmel ossza meg a táblázatot Szerkesztőként."/><TextBlock x:Name="KeyStatus" Grid.Row="5" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource TextMuted}" Text="Még nincs kulcs betöltve."/></Grid></Border>
  <Border Grid.Row="6" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="6"/><RowDefinition Height="42"/></Grid.RowDefinitions><CheckBox x:Name="AutoSyncInput" Checked="DraftChanged" Unchecked="DraftChanged" Content="Automatikus feltöltés mentés után és induláskor" FontSize="11"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="Beállítások mentése" Click="Save"/><Button x:Name="ClearButton" Grid.Column="2" Content="Kapcsolat törlése" Click="Clear"/></Grid></Grid></Border>
  <Border Grid.Row="8" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="TestButton" Content="Kapcsolat tesztje" Click="Test"/><Button x:Name="SyncButton" Grid.Column="2" Content="Naptár szinkronizálása" Click="Sync"/></Grid><Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock x:Name="Status" Width="578" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}"/></Viewbox><Button Grid.Row="3" Content="Google-beállítási útmutató" Click="Guide"/></Grid></Border>
 </Grid>
</UserControl>
