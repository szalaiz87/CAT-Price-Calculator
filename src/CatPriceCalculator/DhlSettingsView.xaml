<UserControl x:Class="CatPriceCalculator.DhlSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="308" /><RowDefinition Height="12" /><RowDefinition Height="180" /><RowDefinition Height="12" /><RowDefinition Height="242" /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="24" /><RowDefinition Height="8" /><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition Height="42" /><RowDefinition Height="12" /><RowDefinition Height="62" /><RowDefinition Height="12" /><RowDefinition Height="34" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Background="White" CornerRadius="5" Width="74" Height="24" Padding="4" Margin="0,0,12,0"><Image Source="{StaticResource DhlLogo}" Stretch="Uniform" /></Border><TextBlock Text="DHL kapcsolat" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Grid.Row="1" Text="Shipment Tracking – Unified • saját, jóváhagyott Consumer Key" Style="{StaticResource Caption}" />
                <TextBlock Grid.Row="3" Text="API-kulcs / Consumer Key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ApiKeyInput" Grid.Row="5" MaxLength="512" PasswordChanged="OptionsChanged" AutomationProperties.Name="DHL API-kulcs" />
                <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="154" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="Címzett irányítószáma" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PostalInput" Grid.Row="2" MaxLength="20" FontSize="13" TextChanged="TextOptionChanged" ToolTip="Nem kötelező. Bizonyos DHL szolgáltatásoknál részletesebb adatokhoz használható." /></Grid>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="DHL szolgáltatás" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ServiceInput" Grid.Row="2" Style="{StaticResource RoundedCombo}" DisplayMemberPath="Name" SelectionChanged="ServiceChanged" /></Grid>
                    <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="6" /><RowDefinition /></Grid.RowDefinitions><TextBlock Text="24 órás keret" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DailyLimitInput" Grid.Row="2" MaxLength="6" FontSize="13" TextChanged="TextOptionChanged" ToolTip="Kezdetben 250. Csak a DHL által jóváhagyott magasabb keret alapján növeld." /></Grid>
                </Grid>
                <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="DHL beállítások mentése" Click="SaveSettings" /><Button x:Name="DeleteKeyButton" Grid.Column="2" Content="Mentett API-kulcs törlése" Click="DeleteKey" /></Grid>
                <TextBlock x:Name="ConnectionStatus" Grid.Row="10" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="24" /><RowDefinition Height="8" /><RowDefinition Height="38" /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Kapcsolat kipróbálása" Style="{StaticResource SectionHeading}" />
                <TextBlock Grid.Row="1" Text="Egy saját DHL csomagszámmal, a mentett beállításokkal. Egy lekérés a keretből." Style="{StaticResource Caption}" />
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions><TextBox x:Name="TestNumberInput" MaxLength="64" FontSize="13" TextChanged="TestEntryChanged" AutomationProperties.Name="Saját DHL tesztcsomag száma" /><Button x:Name="TestButton" Grid.Column="2" Content="Tesztlekérés" Click="TestConnection" IsEnabled="False" /></Grid>
                <TextBlock x:Name="TestStatus" Grid.Row="5" Text="Mentsd a kulcsot, majd adj meg egy saját csomagszámot." Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource InsetCard}">
            <StackPanel>
                <TextBlock Text="Honnan szerezhető be?" Style="{StaticResource SectionHeading}" Margin="0,0,0,10" />
                <TextBlock Text="1. DHL Developer Portal → regisztráció céges e-maillel." TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="2. Shipment Tracking – Unified → Get Access → Create App." TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="3. Jóváhagyás után My Apps → az alkalmazásod → Credentials → Consumer Key → Show." TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="Consumer Secret és OAuth nem szükséges. A demo-key csak mintaadatot ad. A kezdő 250/nap keret fejlesztési célú; éles használathoz Request Upgrade szükséges." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="DHL hozzáférés és hivatalos dokumentáció" Click="OpenDocumentation" Height="32" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="6" Text="A mentett kulcs ehhez a Windows-felhasználóhoz kötött titkosítást kap.&#10;A DHL-csomagokat a Robo Sanyi lapon frissítheted; a minták nem indítanak lekérést." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0" VerticalAlignment="Top" />
    </Grid>
</UserControl>
